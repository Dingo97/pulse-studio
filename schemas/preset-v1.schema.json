{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pulse-studio.dev/schemas/preset-v1.json",
  "title": "Pulse Studio Community Preset v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "formatVersion", "name", "createdWith", "settings"],
  "properties": {
    "$schema": { "const": "https://pulse-studio.dev/schemas/preset-v1.json" },
    "formatVersion": { "const": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "description": { "type": "string", "maxLength": 300 },
    "author": { "type": "string", "maxLength": 100 },
    "license": { "type": "string", "maxLength": 40 },
    "tags": { "type": "array", "maxItems": 12, "items": { "type": "string", "maxLength": 30 }, "uniqueItems": true },
    "createdWith": { "type": "string", "maxLength": 80 },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["background_mode", "background_color", "background_blur", "background_brightness", "background_saturation", "background_video_offset", "background_video_speed", "visualizer", "visualizer_enabled", "visualizer_color", "visualizer_pulse", "overlay", "overlay_intensity", "cover_enabled", "cover_shadow", "font_family", "font_size", "text_color", "text_bold", "text_italic", "text_align", "shadow_color", "shadow_blur", "shadow_distance", "shadow_opacity", "animation", "animation_direction", "word_animation", "active_word_color", "safe_area", "show_safe_guides", "smart_crop", "background_loop", "section_cuts", "lyrics_x_landscape", "lyrics_y_landscape", "lyrics_x_vertical", "lyrics_y_vertical", "visualizer_x_landscape", "visualizer_y_landscape", "visualizer_x_vertical", "visualizer_y_vertical"],
      "properties": {
        "background_mode": { "enum": ["blurred_cover", "solid", "custom"] },
        "background_color": { "$ref": "#/$defs/color" },
        "background_blur": { "type": "integer", "minimum": 0, "maximum": 80 },
        "background_brightness": { "type": "integer", "minimum": 20, "maximum": 150 },
        "background_saturation": { "type": "integer", "minimum": 0, "maximum": 200 },
        "background_video_offset": { "type": "number", "minimum": 0, "maximum": 600 },
        "background_video_speed": { "type": "number", "minimum": 0.25, "maximum": 2 },
        "visualizer": { "enum": ["none", "bars", "wave", "ring"] },
        "visualizer_enabled": { "type": "boolean" },
        "visualizer_color": { "$ref": "#/$defs/color" },
        "visualizer_pulse": { "type": "boolean" },
        "overlay": { "enum": ["none", "grain", "dust", "vignette", "scratches", "light_leaks", "film_burn", "rain", "scanlines", "vhs", "bokeh", "prism"] },
        "overlay_intensity": { "type": "integer", "minimum": 0, "maximum": 100 },
        "cover_enabled": { "type": "boolean" },
        "cover_shadow": { "type": "boolean" },
        "font_family": { "type": "string", "minLength": 1, "maxLength": 80 },
        "font_size": { "type": "integer", "minimum": 24, "maximum": 160 },
        "text_color": { "$ref": "#/$defs/color" },
        "text_bold": { "type": "boolean" },
        "text_italic": { "type": "boolean" },
        "text_align": { "enum": ["left", "center", "right"] },
        "shadow_color": { "$ref": "#/$defs/color" },
        "shadow_blur": { "type": "integer", "minimum": 0, "maximum": 60 },
        "shadow_distance": { "type": "integer", "minimum": 0, "maximum": 40 },
        "shadow_opacity": { "type": "integer", "minimum": 0, "maximum": 100 },
        "animation": { "enum": ["fade", "typewriter", "blur", "pop"] },
        "animation_direction": { "enum": ["up", "down", "left", "right", "none"] },
        "word_animation": { "enum": ["none", "highlight", "pop", "karaoke", "bounce", "constellation", "impact", "ink"] },
        "active_word_color": { "$ref": "#/$defs/color" },
        "safe_area": { "enum": ["auto", "youtube", "shorts", "reels", "tiktok", "none"] },
        "show_safe_guides": { "type": "boolean" },
        "smart_crop": { "type": "boolean" },
        "background_loop": { "enum": ["repeat", "pingpong", "freeze"] },
        "section_cuts": { "type": "boolean" },
        "lyrics_x_landscape": { "$ref": "#/$defs/unit" },
        "lyrics_y_landscape": { "$ref": "#/$defs/unit" },
        "lyrics_x_vertical": { "$ref": "#/$defs/unit" },
        "lyrics_y_vertical": { "$ref": "#/$defs/unit" },
        "visualizer_x_landscape": { "$ref": "#/$defs/unit" },
        "visualizer_y_landscape": { "$ref": "#/$defs/unit" },
        "visualizer_x_vertical": { "$ref": "#/$defs/unit" },
        "visualizer_y_vertical": { "$ref": "#/$defs/unit" }
      }
    }
  },
  "$defs": { "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }, "unit": { "type": "number", "minimum": 0, "maximum": 1 } }
}
